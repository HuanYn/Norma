NORMA_HOST=127.0.0.1
NORMA_PORT=8765
NORMA_DATA_DIR=.norma/data
NORMA_LOG_LEVEL=INFO
NORMA_EMBEDDING_PROVIDER=openclip-multilingual
NORMA_EMBEDDING_DEVICE=auto
NORMA_EMBEDDING_BATCH_SIZE=8
# Feedback is recorded without fitting or applying preference models by default.
# Set adaptive only to opt into the historical Bayesian/legacy learning experiment.
NORMA_PREFERENCE_MODE=record-only
# On Windows Norma selects MKL's SEQUENTIAL layer before importing NumPy/Torch.
# Do not use KMP_DUPLICATE_LIB_OK; duplicate OpenMP runtimes are rejected.
# Optional. Submit background model warmup during API startup.
# NORMA_PREWARM_EMBEDDING=1
# Optional total Norma state budget (generated caches + models + database).
# NORMA_CACHE_BUDGET_GB=20
# Optional. Defaults to NORMA_DATA_DIR/models.
# NORMA_MODEL_CACHE_DIR=D:\NormaModels
NORMA_FACE_PROVIDER=opencv-yunet-sface
# Hybrid default: local retrieval, cloud analysis of selected derived images.
# Set the base URL/model from your provider console and keep the key local.
NORMA_VLM_PROVIDER=openai-compatible
# NORMA_VLM_BASE_URL=https://YOUR_PROVIDER/compatible-mode/v1
# NORMA_VLM_MODEL=YOUR_VISION_MODEL
# NORMA_VLM_API_KEY=YOUR_SECRET_KEY
NORMA_VLM_TIMEOUT_SECONDS=60
# Optional provider-specific request options; omitted from generic requests by default.
NORMA_VLM_THINKING_MODE=provider-default
NORMA_VLM_JSON_RESPONSE_FORMAT=0
# DeepSeek preset: python scripts/start_deepseek.py (hidden local key prompt).
# Uses https://api.deepseek.com, deepseek-flash, thinking disabled, JSON output.
# Set NORMA_VLM_PROVIDER=local to use the existing local Qwen snapshot instead.
# Defaults to NORMA_DATA_DIR/models/qwen3-vl/Qwen3-VL-2B-Instruct-modelscope.
# NORMA_VLM_MODEL_PATH=D:\NormaModels\Qwen3-VL-2B-Instruct-modelscope
NORMA_VLM_MAX_NEW_TOKENS=256
# Optional three-day demo modules; models must be explicitly provisioned.
# NORMA_AESTHETICS_MODEL_DIR=E:/Norma/.norma/data/models/musiq
# NORMA_AESTHETICS_DEVICE=cpu
# Use an SSH loopback tunnel; do not expose the video worker publicly.
# NORMA_VIDEO_BASE_URL=http://127.0.0.1:8766
# NORMA_VIDEO_TOKEN_FILE=E:/Norma/.norma/video-worker.token
